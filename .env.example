# ── Supabase (publique — visible dans le bundle client) ──────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Supabase (privée — NE JAMAIS mettre NEXT_PUBLIC_ devant) ─────
# Nécessaire pour les opérations admin (cleanup, migration, delete account)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Email notifications (Resend) ─────────────────────────────────
# Créez un compte gratuit sur https://resend.com
# Ajoutez votre clé API depuis https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxx

# ── AI Pilot (Anthropic Claude) ────────────────────────────────
# Créez une clé API sur https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxx

# ── URL publique de l'application ──────────────────────────────────
# Optionnel sur Vercel (VERCEL_PROJECT_PRODUCTION_URL est auto-injecté)
# Requis pour le déploiement hors Vercel (Docker, serveur dédié, etc.)
NEXT_PUBLIC_APP_URL=https://votre-domaine.com

# ── Secret pour l'approbation admin des paiements ──────────────────
# Générez une chaîne aléatoire: openssl rand -hex 32
# Ce token est inclus dans l'email de notification de paiement
# L'admin clique sur le lien pour approuver automatiquement
ADMIN_APPROVAL_SECRET=votre-secret-aleatoire

# ── Sécurité admin (optionnel mais recommandé) ────────────────────
# Emails autorisés à utiliser les endpoints sensibles (cleanup, migrations)
# Laisser vide pour désactiver la restriction (déconseillé en production)
ADMIN_EMAILS=admin@example.com

# ── Store Builder : domaine racine des vitrines ────────────────────────────
# Les boutiques sont servies sur <slug>.<ce domaine>, et le middleware s'en sert
# pour distinguer un sous-domaine de vitrine de l'hôte de l'application.
# En développement : laisser vide, « localhost:3000 » est déduit.
NEXT_PUBLIC_STORE_ROOT_DOMAIN=profitpilot.app

# ── Studio IA : retouche des photos produits ───────────────────────────────
# Optionnel. Sans clé, le Studio affiche « fonction non activée » et le reste
# de la boutique fonctionne normalement.
#
# Un fournisseur suffit. Si les deux sont présents, AI_IMAGE_PROVIDER tranche.
AI_IMAGE_PROVIDER=replicate

# Replicate — https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_xxxxxxxxxx

# fal.ai — https://fal.ai/dashboard/keys
# FAL_KEY=xxxxxxxx:xxxxxxxx

# Modèles, surchargeables sans redéploiement (valeurs par défaut dans
# lib/ai/imageEnhancer.ts) :
# REPLICATE_MODEL_PRODUCT_SCENE=logerzhu/ad-inpaint
# REPLICATE_MODEL_BG_REMOVE=851-labs/background-remover
# REPLICATE_MODEL_UPSCALE=nightmareai/real-esrgan
#
# ⚠️ NEXT_PUBLIC_APP_URL est OBLIGATOIRE pour le Studio IA : c'est l'adresse
# que le fournisseur rappelle une fois l'image prête.

# ── Avis clients ─────────────────────────────────────────────────────────────
# Expéditeur des courriels. Doit être un domaine vérifié chez Resend, sinon le
# message part mais n'arrive pas en boîte principale.
EMAIL_FROM=
# Secret de signature des jetons de dépôt d'avis (lib/reviewToken.ts).
# FACULTATIF : sans lui, la clé de service sert de secret — le jeton reste
# valide et ne sort jamais du serveur. Le poser isole les deux usages.
REVIEW_TOKEN_SECRET=
