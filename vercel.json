{
  "framework": "nextjs",
  "buildCommand": "NODE_OPTIONS=--max-old-space-size=4096 next build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 23 * * 0"
    }
  ]
}
